# Copy to .env.local and fill in. .env.local is gitignored.
# Neon: copy the connection string from the project dashboard (keep ?sslmode=require).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The chat assistant (the round button at the bottom right). It uses Google's Gemini API.
# Get a free key at https://aistudio.google.com/apikey and add it here AND in the Vercel project's environment variables.
# Without a key the chat opens but says it is not set up yet. Everything else works either way.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-flash-lite-latest, the cheapest family). For smarter answers try gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# Login. In production the whole app (pages and API) needs a signed-in staff member; locally it stays open until
# STAFF_ACCOUNTS is set, so you can ignore this while developing.
# One entry per person, "name:scrypt:salt:hash", separated by commas. Make an entry with:
#   npm run hash-password -- sahil "a long password"
STAFF_ACCOUNTS=
# A long random text that signs the login cookie (16 characters or more). Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
